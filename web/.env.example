# Copy to .env.local (git-ignored) and fill in. Never commit real credentials.
# These are server-only: none of them use the NEXT_PUBLIC_ prefix, so they are
# never sent to the browser.

# Supabase Postgres connection string. For local development use the direct
# connection string from the Supabase dashboard (Connect). The pooler is not
# working yet (docs/DECISIONS.md D-012). Prefer a read-only role once one has
# been approved and created (docs/DATA_VERIFICATION.md section 6).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Recommended: Supabase's CA certificate (Project Settings → Database → SSL
# configuration → download certificate), pasted as one line with \n for line
# breaks. When set, TLS is verified against it and any sslmode in
# DATABASE_URL is ignored. Keep the downloaded .crt file outside the repo.
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# "supabase" (default) or "fixture". "fixture" labels every page as local
# sample data; npm run preview:fixture sets it for you.
# APP_DATA_SOURCE=supabase
